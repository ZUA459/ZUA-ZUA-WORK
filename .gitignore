<title>ZUA ZUA WORK</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="Portal de la comunidad de La Cueva Zua Zua en Roblox: novedades, equipaciones, creadores y ZUA AI.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Figtree:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: portal oscuro tipo cueva. Cabecera fija con anclas, hero con brasa, 4 secciones apiladas, ZUA AI como panel principal. */
:root{
  --bg:#0b0a0f; --surface:#14121a; --surface2:#1c1923; --line:#2b2735;
  --fg:#f2eee8; --muted:#a8a2b4; --ember:#ff6a1f; --ember-ink:#1a0a02; --ok:#5fd38d;
  --display:"Anton","Impact","Arial Narrow",sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{background:var(--bg);color:var(--fg);font:16px/1.55 var(--body);margin:0;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:0 48px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
.wrap{max-width:1080px;margin:0 auto}
h1,h2,h3{font-family:var(--display);font-weight:400;letter-spacing:.01em;text-transform:uppercase;margin:0;text-wrap:balance;line-height:1.02}
a{color:inherit}
:focus-visible{outline:2px solid var(--ember);outline-offset:3px}
.mono{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}

